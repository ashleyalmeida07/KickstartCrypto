			"title": "Campaign",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"cancelCampaign()": {
					"notice": "Creator can cancel the campaign before deadline (if goal not reached).         Backers may then claim refunds."
				},
				"claimRefund()": {
					"notice": "Backers claim refund if goal not met after deadline,         or if the campaign is cancelled."
				},
				"contribute()": {
					"notice": "Contribute ETH to this campaign."
				},
				"finalizePayout(uint256)": {
					"notice": "Anyone can trigger payout release if votes_for already exceeds quorum.         Useful for finalizing without a new vote tx."
				},
				"postUpdate(string)": {
					"notice": "Creator posts an update (stores IPFS CID on-chain)."
				},
				"requestPayout(uint256)": {
					"notice": "Creator requests payout for a specific milestone.         Backers then vote to approve or reject."
				},
				"vote(uint256,bool)": {
					"notice": "Backers vote to approve or reject a milestone payout."
				}
			},
			"notice": "Trustless crowdfunding contract with milestone-based escrow,         backer voting, and automatic refunds.",
			"version": 1
		}
